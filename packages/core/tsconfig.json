{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "rootDir": "src",
    // `lib` se limita a ECMAScript y `types` queda vacío A PROPOSITO: es la
    // forma de que TypeScript, y no un revisor humano, garantice que el
    // dominio no toca `document`, `window` ni `fetch`. En el momento en que
    // alguien lo intente, `tsc -p packages/core` falla.
    "lib": ["ES2022"],
    "types": []
  }
}
