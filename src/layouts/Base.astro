---
/**
 * Base layout: document shell, fonts, styles and SEO head.
 * Locale is resolved at build time — there is no runtime i18n engine.
 */
import "../styles/fonts.css";
import "../styles/global.css";

import { createHash } from "node:crypto";
import { ANTI_FLASH_SOURCE } from "../lib/anti-flash";

import Masthead from "../components/Masthead.astro";
import Footer from "../components/Footer.astro";
import { DEFAULT_LOCALE, LOCALES, htmlLang, localePath, t, type Locale } from "../i18n";
import { SITE } from "../config/site";
import { withBase } from "../lib/paths";

interface Props {
  locale?: Locale;
  title: string;
  description: string;
  /** Route path in the default locale, e.g. "/tools". Used to build language alternates. */
  path?: string;
  /** Suppress indexing for utility pages if ever needed. */
  noindex?: boolean;
  /**
   * A page with no address of its own: the 404, which the host serves for ANY
   * unknown path. It declares no canonical, no language alternates and no
   * og:url, because each of those would name an address that is not it (the
   * old 404 pointed hreflang at `/en/404`, which was never built). Its language
   * switch leads to each locale's home instead.
   */
  standalone?: boolean;
}

const {
  locale = DEFAULT_LOCALE,
  title,
  description,
  path = "/",
  noindex = false,
  standalone = false,
} = Astro.props;

const siteName = "LinguaLab";
const fullTitle = path === "/" ? `${siteName} — ${title}` : `${title} · ${siteName}`;
// La misma URL que `SITE.url`: el literal duplicado fue lo que dejo los
// canonicos apuntando a un dominio ajeno cuando el sitio se mudo.
const siteUrl = Astro.site ?? SITE.url;
const canonical = new URL(localePath(locale, path), siteUrl);
// The share card is drawn by scripts/build-social-card.mjs from the site's own
// mark, fonts and palette. An og:image must be absolute.
const socialCard = new URL(withBase("/og-card.png"), siteUrl).href;
const socialCardAlt = locale === "es"
  ? "LinguaLab: herramientas de análisis lingüístico que corren en el navegador"
  : "LinguaLab: linguistic analysis tools that run in the browser";

/* The anti-flash script has to be inline (it runs before first paint), so
   the CSP needs its hash. Hashing the exact constant we emit keeps the two
   from drifting apart. */
const antiFlashHash: `sha256-${string}` = `sha256-${createHash("sha256")
  .update(ANTI_FLASH_SOURCE)
  .digest("base64")}`;
Astro.csp?.insertScriptHash({ hash: antiFlashHash, kind: "default" });
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    {!standalone && <link rel="canonical" href={canonical.href} />}
    {noindex && <meta name="robots" content="noindex, follow" />}

    {/* Language alternates point at the same route in every locale. */}
    {!standalone && LOCALES.map((l) => (
      <link
        rel="alternate"
        hreflang={l === DEFAULT_LOCALE ? "x-default" : l}
        href={new URL(localePath(l, path), siteUrl).href}
      />
    ))}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!standalone && <meta property="og:url" content={canonical.href} />}
    <meta property="og:locale" content={htmlLang(locale)} />
    <meta property="og:image" content={socialCard} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialCardAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialCard} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#fbf7ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a140f" media="(prefers-color-scheme: dark)" />

    {/* Applied before first paint so an explicit theme choice never flashes.
        Kept inline and tiny on purpose: it cannot be deferred. Its hash is
        registered with the CSP above. */}
    <script is:inline set:html={ANTI_FLASH_SOURCE} />
  </head>

  <body>
    <a class="skip-link" href="#main">{t(locale, "skip")}</a>

    <Masthead locale={locale} path={standalone ? "/" : path} />

    <main id="main">
      <slot />
    </main>

    <Footer locale={locale} />

    <script>
      import { initThemeToggle } from "../scripts/core/theme";
      import { initNavDisclosure } from "../scripts/core/nav";
      import { initMasthead } from "../scripts/core/masthead";

      initThemeToggle();
      initNavDisclosure();
      initMasthead();
    </script>
  </body>
</html>
