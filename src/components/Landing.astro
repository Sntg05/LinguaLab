---
/**
 * Landing page. Locale-agnostic: both / and /en/ render this component
 * with a different locale, so the markup exists in exactly one place.
 *
 * Every count on this page is derived from data: the catalog, the IPA chart,
 * the tree examples and the bibliography. The previous landing said "three
 * labs" long after there were ten; a number typed by hand goes stale the day
 * the next tool ships.
 *
 * The page keeps two kinds of tool visibly apart: the ones that open here
 * (grouped by level of analysis) and the ones that live on another site (a
 * separate directory that names the destination).
 */
import type { ToolDescriptor } from "@lingualab/core";
import { ANALYSIS_LEVELS } from "@lingualab/core";
import { lingualab } from "../composition-root";
import { AREA_KEYS, LANGUAGE_KEYS, STATUS_KEYS, hostOf } from "../config/catalog-labels";
import { SITE_ROUTES } from "../config/site";
import { BIBLIOGRAPHY } from "../data/bibliography";
import { IPA_CHART } from "../data/ipa-chart";
import { TOOL_HIGHLIGHTS } from "../data/tool-highlights";
import { TREE_EXAMPLES } from "../data/trees/examples";
import { localePath, t, type Locale, type MessageKey } from "../i18n";
import { transcribe, diffRuns } from "../scripts/home/transcriber";
import PhonemeOfDay from "./PhonemeOfDay.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === "es";

const listed = await lingualab.listTools();
const tools: readonly ToolDescriptor[] = listed.ok ? listed.value : [];

const byLevel = (subset: readonly ToolDescriptor[]) =>
  ANALYSIS_LEVELS.map((area) => ({
    area,
    tools: subset.filter((tool) => tool.area === area),
  })).filter((group) => group.tools.length > 0);

const integrated = tools.filter(
  (tool) => tool.integration === "embedded" && SITE_ROUTES[tool.id] !== undefined,
);
const external = tools.filter((tool) => tool.integration === "external-link");
const externalLinked = external.filter((tool) => tool.url !== undefined);
const experimentalCount = integrated.filter((tool) => tool.status === "experimental").length;

const integratedLevels = byLevel(integrated);
const externalLevels = byLevel(external);

const ipaCount = IPA_CHART.categories.reduce((n, c) => n + c.symbols.length, 0);
const treeCount = Object.keys(TREE_EXAMPLES).length;
const bibliographyCount = BIBLIOGRAPHY.length;

const languageList = (tool: ToolDescriptor): string =>
  tool.languages
    .map((code) => {
      const key = LANGUAGE_KEYS[code];
      return key === undefined ? code : t(locale, key);
    })
    .join(", ");

const summaryOf = (tool: ToolDescriptor): string =>
  TOOL_HIGHLIGHTS[tool.id]?.summary[locale] ?? tool.notes?.[locale] ?? "";

/* ---- Hero ---- */
const hero = es
  ? {
      title: "Transcribe, anota y mide la lengua sin salir del navegador.",
      lede: `${integrated.length} herramientas integradas, de la fonética a la documentación, y un directorio de ${external.length} programas externos que la disciplina usa a diario. Pensada para estudiantes de lingüística de la Universidad Nacional de Colombia.`,
      primary: "Explorar las herramientas",
      secondary: "Ver el catálogo completo",
    }
  : {
      title: "Transcribe, annotate and measure language without leaving your browser.",
      lede: `${integrated.length} integrated tools, from phonetics to documentation, and a directory of ${external.length} external programs the discipline uses every day. Built for linguistics students at Universidad Nacional de Colombia.`,
      primary: "Explore the tools",
      secondary: "See the full catalog",
    };

/* The default sentence is analysed twice in the hero: transcribed by the
   engine and parsed in the tree. The tree is static, so it names its sentence. */
const SENTENCE = "la lluvia cae";
const initial = transcribe(SENTENCE);
const initialRuns = diffRuns(initial.phonemic, initial.phonetic);

const lab = es
  ? {
      title: "Pruébalo: de la ortografía al AFI",
      label: "Escribe en español",
      phonemic: "Fonológica",
      phonetic: "Fonética",
      note: "Resaltado: lo que cambia la capa alofónica. Tabla de demostración de español latinoamericano con yeísmo.",
      open: "Abrir Ortografía a AFI",
      treeCaption: `Constituyentes de «${SENTENCE}»`,
      treeLabel: `Árbol de constituyentes: [S [SN [Det la] [N lluvia]] [SV [V cae]]]`,
      np: "SN",
      vp: "SV",
    }
  : {
      title: "Try it: from spelling to IPA",
      label: "Type in Spanish",
      phonemic: "Phonological",
      phonetic: "Phonetic",
      note: "Highlighted: what the allophonic layer changes. Latin American Spanish demo table with yeísmo.",
      open: "Open Spelling to IPA",
      treeCaption: `Constituents of «${SENTENCE}»`,
      treeLabel: `Constituency tree: [S [NP [Det la] [N lluvia]] [VP [V cae]]]`,
      np: "NP",
      vp: "VP",
    };

/* ---- Facts: every value derived ---- */
const facts: { label: string; value: number }[] = es
  ? [
      { label: "herramientas integradas", value: integrated.length },
      { label: "programas externos enlazados", value: externalLinked.length },
      { label: "símbolos en la tabla AFI", value: ipaCount },
      { label: "tipos de árbol", value: treeCount },
      { label: "referencias bibliográficas", value: bibliographyCount },
    ]
  : [
      { label: "integrated tools", value: integrated.length },
      { label: "linked external programs", value: externalLinked.length },
      { label: "symbols in the IPA chart", value: ipaCount },
      { label: "tree types", value: treeCount },
      { label: "bibliography entries", value: bibliographyCount },
    ];

const notes: { headingKey: MessageKey; body: string }[] = [
  {
    headingKey: "purpose.1t",
    body: es
      ? "Cada herramienta cubre una tarea real del oficio: transcribir, anotar, segmentar, contar, comparar. Los resultados se exportan en formatos que puedes entregar, citar y reutilizar."
      : "Each tool covers a real task of the trade: transcribe, annotate, segment, count, compare. Results export in formats you can hand in, cite and reuse.",
  },
  {
    headingKey: "purpose.2t",
    body: es
      ? "Árboles a SVG, Newick, CoNLL-U y PNG; anotaciones a TextGrid; corpus y mediciones a CSV. Los mismos formatos que usa la investigación."
      : "Trees to SVG, Newick, CoNLL-U and PNG; annotations to TextGrid; corpora and measurements to CSV. The same formats research uses.",
  },
];

const newTab = t(locale, "catalog.externalNewTab");
---

<section class="section hero" aria-labelledby="hero-title">
  <div class="shell hero__grid">
    <div class="hero__copy">
      <h1 class="hero__title" id="hero-title">{hero.title}</h1>
      <p class="hero__lede">{hero.lede}</p>

      <div class="cluster hero__actions">
        <a class="btn btn--primary btn--lg" href="#integradas">{hero.primary}</a>
        <a class="btn btn--lg" href={localePath(locale, "/catalogo")}>{hero.secondary}</a>
      </div>

      {
        experimentalCount > 0 && (
          <p class="hero__aside">
            {es
              ? `${experimentalCount} de las integradas están en fase experimental y lo dicen en su ficha.`
              : `${experimentalCount} of the integrated tools are experimental, and their pages say so.`}
          </p>
        )
      }
    </div>

    <div class="lab" data-transcriber>
      <p class="lab__title" id="lab-title">{lab.title}</p>

      <label class="lab__label" for="lab-input">{lab.label}</label>
      <input
        class="lab__input"
        id="lab-input"
        type="text"
        value={SENTENCE}
        autocomplete="off"
        spellcheck="false"
        lang="es"
        data-transcriber-input
      />

      <dl class="lab__out">
        <div class="lab__row">
          <dt>{lab.phonemic}</dt>
          <dd>
            <output class="ipa lab__ipa" for="lab-input" data-transcriber-phonemic
              >/{initial.phonemic}/</output
            >
          </dd>
        </div>
        <div class="lab__row">
          <dt>{lab.phonetic}</dt>
          <dd>
            <output class="ipa lab__ipa" for="lab-input" data-transcriber-phonetic
              >[{initialRuns.map((run) => (run.changed ? <mark>{run.text}</mark> : run.text))}]</output
            >
          </dd>
        </div>
      </dl>
      <p class="lab__note">{lab.note}</p>

      <figure class="lab__tree">
        <svg viewBox="0 0 300 172" role="img" aria-label={lab.treeLabel}>
          <g class="tree__edges">
            <path d="M150 26 L88 52 M150 26 L222 52"></path>
            <path d="M88 72 L54 98 M88 72 L122 98 M222 72 L222 98"></path>
            <path d="M54 118 L54 138 M122 118 L122 138 M222 118 L222 138" class="tree__lex"></path>
          </g>
          <g class="tree__nodes" text-anchor="middle">
            <text x="150" y="20">S</text>
            <text x="88" y="66">{lab.np}</text>
            <text x="222" y="66">{lab.vp}</text>
            <text x="54" y="112">Det</text>
            <text x="122" y="112">N</text>
            <text x="222" y="112">V</text>
          </g>
          <g class="tree__leaves" text-anchor="middle">
            <text x="54" y="158">la</text>
            <text x="122" y="158">lluvia</text>
            <text x="222" y="158">cae</text>
          </g>
        </svg>
        <figcaption>{lab.treeCaption}</figcaption>
      </figure>

      <a class="lab__open" href={localePath(locale, "/ortografia")}>{lab.open}</a>
    </div>
  </div>
</section>

<section class="section" id="integradas" aria-labelledby="integrated-heading">
  <div class="shell">
    <header class="part-head">
      <h2 id="integrated-heading">
        {es ? "Herramientas integradas" : "Integrated tools"}
        <span class="part-head__count">{integrated.length}</span>
      </h2>
      <p>
        {
          es
            ? "Se abren aquí mismo y trabajan en tu navegador, sin instalar nada. Están ordenadas por nivel de análisis, del sonido a la documentación."
            : "They open right here and work in your browser, with nothing to install. They are ordered by level of analysis, from sound to documentation."
        }
      </p>
    </header>

    <div class="levels">
      {
        integratedLevels.map((group) => (
          <section class="level" aria-labelledby={`level-${group.area}`}>
            <h3 class="level__name" id={`level-${group.area}`}>
              {t(locale, AREA_KEYS[group.area])}
            </h3>
            <ul class="tiles" role="list">
              {group.tools.map((tool) => {
                const highlight = TOOL_HIGHLIGHTS[tool.id];
                const languages = languageList(tool);
                return (
                  <li>
                    <a class="tile" href={localePath(locale, SITE_ROUTES[tool.id] ?? "/catalogo")}>
                      {highlight?.sample && (
                        <span
                          class={`tile__sample ${highlight.sampleKind === "ipa" ? "ipa" : "mono"}`}
                          aria-hidden="true"
                        >
                          {highlight.sample}
                        </span>
                      )}
                      <h4 class="tile__name">{tool.name[locale]}</h4>
                      <span class="tile__summary">{summaryOf(tool)}</span>
                      {(tool.status !== "stable" || languages !== "") && (
                        <span class="tile__meta">
                          {tool.status !== "stable" && (
                            <span class="badge badge--warn">{t(locale, STATUS_KEYS[tool.status])}</span>
                          )}
                          {languages !== "" && <span class="tile__langs">{languages}</span>}
                        </span>
                      )}
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>

<PhonemeOfDay locale={locale} />

<section class="section externals" id="externas" aria-labelledby="external-heading">
  <div class="shell">
    <header class="part-head">
      <h2 id="external-heading">
        {es ? "Fuera de LinguaLab" : "Outside LinguaLab"}
        <span class="part-head__count part-head__count--ext">{external.length}</span>
      </h2>
      <p>
        {
          es
            ? "Programas y servicios de otros equipos que complementan las herramientas integradas. No forman parte de LinguaLab: cada enlace se abre en una pestaña nueva, en el sitio de su autor."
            : "Programs and services by other teams that complement the integrated tools. They are not part of LinguaLab: each link opens in a new tab, on its author's site."
        }
      </p>
    </header>

    <div class="directory">
      {
        externalLevels.map((group) => (
          <section class="directory__level" aria-labelledby={`ext-${group.area}`}>
            <h3 class="directory__area" id={`ext-${group.area}`}>
              {t(locale, AREA_KEYS[group.area])}
            </h3>
            <ul class="directory__list" role="list">
              {group.tools.map((tool) => (
                <li>
                  {tool.url ? (
                    <a
                      class="entry"
                      href={tool.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-external
                    >
                      <span class="entry__name">{tool.name[locale]}</span>
                      <span class="entry__summary">{summaryOf(tool)}</span>
                      <span class="entry__host">
                        {hostOf(tool.url)}
                        <span aria-hidden="true"> ↗</span>
                        <span class="u-visually-hidden"> ({newTab})</span>
                      </span>
                    </a>
                  ) : (
                    <div class="entry entry--planned">
                      <span class="entry__name">{tool.name[locale]}</span>
                      <span class="entry__summary">{summaryOf(tool)}</span>
                      <span class="entry__host">
                        <span class="badge">{t(locale, STATUS_KEYS[tool.status])}</span>
                      </span>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>

<section class="section" aria-labelledby="facts-heading">
  <div class="shell">
    <header class="part-head">
      <h2 id="facts-heading">{es ? "Lo que hay dentro" : "What is inside"}</h2>
    </header>

    <dl class="facts">
      {
        facts.map((fact) => (
          <div class="fact">
            <dt class="fact__label">{fact.label}</dt>
            <dd class="fact__value">{fact.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="notes">
      {
        notes.map((note) => (
          <div class="note">
            <h3 class="note__title">{t(locale, note.headingKey)}</h3>
            <p class="note__body">{note.body}</p>
          </div>
        ))
      }
    </div>

    <p class="purpose__foot">
      {t(locale, "purpose.local")}{" "}
      <a href={localePath(locale, "/seguridad")}>{t(locale, "purpose.localLink")}</a>
    </p>
  </div>
</section>

<script>
  import { initTranscriber } from "../scripts/home/transcriber";
  import { safeInit } from "../scripts/core/safe";

  safeInit("landing transcriber", initTranscriber);
</script>

<style>
  /* ---- Hero ---- */
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 6vw, 5rem);
    background: var(--bg);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }

  @media (width >= 62rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }
  }

  .hero__title {
    font-size: clamp(2.6rem, 1.6rem + 4.2vw, 5rem);
    font-weight: 720;
    line-height: 1.02;
    letter-spacing: -0.045em;
    max-width: 14ch;
    margin-block-end: var(--space-m);
  }

  .hero__lede {
    max-width: 52ch;
    font-size: var(--step-1);
    line-height: var(--leading-normal);
    color: var(--ink-muted);
  }

  .hero__actions {
    margin-block-start: var(--space-l);
  }

  .hero__aside {
    margin: var(--space-m) 0 0;
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  /* ---- The live lab panel: the one bold element of the page ---- */
  .lab {
    display: grid;
    gap: var(--space-2xs);
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-l);
  }

  .lab__title {
    margin: 0 0 var(--space-2xs);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 680;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .lab__label {
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--ink-muted);
  }

  .lab__input {
    width: 100%;
    padding: 0.75rem 1rem;
    font: inherit;
    font-size: var(--step-1);
    color: var(--ink);
    background: var(--bg);
    border: 2px solid var(--line-strong);
    border-radius: var(--radius-m);
  }

  .lab__input:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-wash);
  }

  .lab__out {
    display: grid;
    gap: var(--space-2xs);
    margin: var(--space-xs) 0 0;
  }

  .lab__row {
    display: grid;
    gap: 0 var(--space-s);
  }

  @media (width >= 30rem) {
    .lab__row {
      grid-template-columns: 7.5rem minmax(0, 1fr);
      align-items: baseline;
    }
  }

  .lab__row dt {
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--ink-faint);
  }

  .lab__row dd {
    margin: 0;
    min-width: 0;
  }

  .lab__ipa {
    display: block;
    font-size: var(--step-3);
    line-height: 1.25;
    color: var(--accent);
    overflow-wrap: anywhere;
  }

  .lab__ipa :global(mark) {
    color: var(--saffron-ink);
    background: var(--saffron);
    border-radius: var(--radius-xs);
    padding-inline: 0.08em;
  }

  .lab__note {
    margin: 0;
    font-size: var(--step--2);
    color: var(--ink-faint);
  }

  .lab__tree {
    margin: var(--space-s) 0 0;
    padding: var(--space-s) var(--space-s) var(--space-2xs);
    background: var(--bg-sunken);
    border-radius: var(--radius-m);
  }

  .lab__tree svg {
    display: block;
    width: 100%;
    max-width: 22rem;
    height: auto;
    margin-inline: auto;
  }

  .tree__edges path {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .tree__edges .tree__lex {
    stroke-dasharray: 2 4;
  }

  .tree__nodes text {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
    fill: var(--accent);
  }

  .tree__leaves text {
    font-family: var(--font-sans);
    font-size: 15px;
    font-style: italic;
    fill: var(--ink);
  }

  .lab__tree figcaption {
    margin-block-start: var(--space-3xs);
    font-size: var(--step--2);
    text-align: center;
    color: var(--ink-faint);
  }

  .lab__open {
    justify-self: start;
    margin-block-start: var(--space-2xs);
    font-size: var(--step--1);
    font-weight: 700;
  }

  /* ---- Part heads: the title carries its count ---- */
  .part-head {
    max-width: 46rem;
    margin-block-end: var(--space-xl);
  }

  .part-head h2 {
    font-size: var(--step-4);
    margin-block-end: var(--space-xs);
  }

  .part-head p {
    margin: 0;
    font-size: var(--step-0);
    line-height: var(--leading-normal);
    color: var(--ink-muted);
  }

  .part-head__count {
    display: inline-grid;
    vertical-align: 0.35em;
    margin-inline-start: 0.25em;
    place-items: center;
    min-width: 2.2em;
    height: 2.2em;
    padding-inline: 0.5em;
    font-family: var(--font-sans);
    font-size: 0.42em;
    font-weight: 800;
    letter-spacing: 0;
    color: var(--accent-ink);
    background: var(--accent);
    border-radius: var(--radius-pill);
  }

  .part-head__count--ext {
    color: var(--ext);
    background: transparent;
    border: 2px solid currentColor;
  }

  /* ---- Integrated: levels of analysis as the rows of the page ---- */
  .levels {
    display: grid;
    gap: var(--space-l);
  }

  .level {
    display: grid;
    gap: var(--space-s);
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--line);
  }

  @media (width >= 56rem) {
    .level {
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: var(--space-l);
    }
  }

  .level__name {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--ink-muted);
  }

  .tiles {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tiles > li {
    display: flex;
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    width: 100%;
    padding: var(--space-m);
    text-decoration: none;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    transition:
      border-color var(--dur-base) ease,
      box-shadow var(--dur-base) ease,
      transform var(--dur-base) var(--ease-out);
  }

  .tile:hover {
    text-decoration: none;
    border-color: var(--accent-line);
    box-shadow: var(--shadow-m);
    transform: translateY(-2px);
  }

  .tile__sample {
    font-size: var(--step-2);
    line-height: 1.2;
    color: var(--accent);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tile__sample.mono {
    font-size: var(--step-0);
    font-weight: 600;
    padding: 0.3em 0.6em;
    justify-self: start;
    align-self: flex-start;
    background: var(--accent-wash);
    border-radius: var(--radius-s);
  }

  .tile__name {
    margin: var(--space-3xs) 0 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 680;
    letter-spacing: -0.02em;
  }

  .tile:hover .tile__name {
    color: var(--accent);
  }

  .tile__summary {
    font-size: var(--step--1);
    line-height: var(--leading-normal);
    color: var(--ink-muted);
  }

  .tile__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-start: auto;
    padding-block-start: var(--space-xs);
  }

  .tile__langs {
    font-size: var(--step--2);
    font-weight: 650;
    color: var(--ink-faint);
  }

  /* ---- External directory: a list, not tiles, in its own colour ---- */
  .externals {
    background: var(--bg-sunken);
    border-block: 1px solid var(--line);
  }

  .directory {
    display: grid;
    gap: var(--space-l);
  }

  @media (width >= 56rem) {
    .directory__level {
