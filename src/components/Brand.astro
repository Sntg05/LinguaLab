---
/**
 * The LinguaLab brand lockup: mark plus wordmark.
 *
 * Extracted because the masthead and the footer each carried their own
 * byte-identical copy of the mark, so any change had to be made twice and the
 * two could drift apart silently.
 *
 * The wordmark is deliberately not translated: "LinguaLab" is a proper noun.
 * It is set in the UI face rather than the display serif so the lockup reads
 * as a product name instead of a chapter heading, tightened, with the second
 * half in the accent colour.
 *
 * The mark joins the two notations a linguist reads first: square brackets,
 * which enclose a phonetic transcription, around a small syntax tree whose
 * root is lit in the highlighter colour. It sits on a solid tile so it keeps
 * its shape at favicon size; public/favicon.svg carries the same drawing.
 */
import { localePath, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<a class="brand" href={localePath(locale, "/")}>
  <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect class="brand__tile" width="32" height="32" rx="9"></rect>
    <path
      d="M10 7.5H7v17h3M22 7.5h3v17h-3"
      fill="none"
      stroke="#fff"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <path
      d="M16 11.5 11.8 20.5M16 11.5l4.2 9"
      fill="none"
      stroke="#fff"
      stroke-width="1.8"
      stroke-linecap="round"></path>
    <circle class="brand__root" cx="16" cy="11" r="2.6"></circle>
    <circle cx="11.8" cy="21" r="2.1" fill="#fff"></circle>
    <circle cx="20.2" cy="21" r="2.1" fill="#fff"></circle>
  </svg>
  <span class="brand__name">Lingua<span class="brand__name-accent">Lab</span></span>
</a>
