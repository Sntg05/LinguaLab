---
import { SITE } from "../config/site";
import { DEFAULT_LOCALE, localePath, t, type Locale, type MessageKey } from "../i18n";

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;

interface FooterGroup {
  headingKey: MessageKey;
  links: { path: string; labelKey: MessageKey }[];
}

const groups: FooterGroup[] = [
  {
    headingKey: "nav.tools",
    links: [
      { path: "/tools", labelKey: "nav.tools" },
      { path: "/fono", labelKey: "nav.ipa" },
      { path: "/arboles", labelKey: "nav.trees" },
    ],
  },
  {
    headingKey: "nav.resources",
    links: [
      { path: "/bibliografia", labelKey: "nav.resources" },
      { path: "/glosario", labelKey: "nav.glossary" },
    ],
  },
  {
    headingKey: "nav.about",
    links: [
      { path: "/acerca", labelKey: "nav.about" },
      { path: "/seguridad", labelKey: "nav.security" },
    ],
  },
];

---

<footer class="footer">
  <div class="shell">
    <div class="footer__grid">
      <div>
        <a class="brand" href={localePath(locale, "/")}>
          <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
            <path d="M16 6 L4 27" stroke="currentColor" stroke-width="1.75" opacity=".45" fill="none"></path>
            <path d="M16 6 L28 27" stroke="currentColor" stroke-width="1.75" opacity=".45" fill="none"></path>
            <circle cx="16" cy="6" r="4.5" fill="currentColor"></circle>
            <circle cx="4" cy="27" r="3.75" fill="none" stroke="currentColor" stroke-width="1.75"></circle>
            <circle cx="28" cy="27" r="3.75" fill="none" stroke="currentColor" stroke-width="1.75" opacity=".5"></circle>
          </svg>
          <span class="brand__name">LinguaLab</span>
        </a>
        <p class="muted" style="margin-block-start: var(--space-s); max-width: 34ch; font-size: var(--step--1)">
          {t(locale, "foot.about")}
        </p>
        <p class="faint" style="font-size: var(--step--2); font-family: var(--font-mono)">
          {t(locale, "foot.local")}
        </p>
      </div>

      {
        groups.map((group) => (
          <nav class="footer__col" aria-labelledby={`footer-${group.headingKey}`}>
            <h2 id={`footer-${group.headingKey}`}>{t(locale, group.headingKey)}</h2>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a href={localePath(locale, link.path)}>{t(locale, link.labelKey)}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="footer__base">
      <span>{t(locale, "foot.rights")}</span>
      <a href={SITE.repository} rel="noopener noreferrer">{t(locale, "foot.source")}</a>
    </div>
  </div>
</footer>
