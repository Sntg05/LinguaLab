---
import { ABOUT_NAV_ITEMS, REFERENCE_NAV_ITEMS, SITE, TOOL_NAV_ITEMS } from "../config/site";
import { DEFAULT_LOCALE, localePath, t, type Locale, type MessageKey } from "../i18n";
import Brand from "./Brand.astro";

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;

interface FooterGroup {
  headingKey: MessageKey;
  links: { path: string; labelKey: MessageKey }[];
}

/**
 * Everything the masthead deliberately leaves out, derived from `NAV_ITEMS` so
 * it cannot go stale on its own.
 *
 * POR QUE SE DERIVA Y NO SE ESCRIBE ACA
 *
 * Esta lista estaba escrita a mano y se quedo vieja dos veces: ofrecia tres
 * herramientas cuando ya habia cinco, y encabezaba la columna con el nombre de
 * una de ellas («Estacion textual») en vez del de la columna. Derivarla de la
 * misma tabla que usa el masthead hace que la proxima herramienta aparezca en el
 * pie sin que nadie se acuerde de este archivo.
 *
 * Security is not a column of its own here: it sits in the legal line below,
 * which is where a reader looks for it only when they actually want it.
 */
const groups: FooterGroup[] = [
  { headingKey: "foot.tools", links: TOOL_NAV_ITEMS.map(({ path, labelKey }) => ({ path, labelKey })) },
  {
    headingKey: "nav.resources",
    links: REFERENCE_NAV_ITEMS.map(({ path, labelKey }) => ({ path, labelKey })),
  },
  {
    headingKey: "foot.about.col",
    links: ABOUT_NAV_ITEMS.map(({ path, labelKey }) => ({ path, labelKey })),
  },
];
---

<footer class="footer">
  <div class="shell">
    <div class="footer__grid">
      <div>
        <Brand locale={locale} />
        <p class="footer__about">{t(locale, "foot.about")}</p>
        <p class="footer__note">{t(locale, "foot.local")}</p>
      </div>

      {
        groups.map((group) => (
          <nav class="footer__col" aria-labelledby={`footer-${group.headingKey}`}>
            <h2 id={`footer-${group.headingKey}`}>{t(locale, group.headingKey)}</h2>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a href={localePath(locale, link.path)}>{t(locale, link.labelKey)}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="footer__base">
      <span>{t(locale, "foot.rights")}</span>
      <span class="cluster">
        <a href={localePath(locale, "/seguridad")}>{t(locale, "nav.security")}</a>
        {
          SITE.repository && (
            <a href={SITE.repository} rel="noopener noreferrer">
              {t(locale, "foot.source")}
            </a>
          )
        }
      </span>
    </div>

    {/* This project is the author's own and merely names an institution as its
        intended audience. Saying so plainly costs one line and removes any
        reading of institutional endorsement. */}
    <p class="footer__disclaimer">{t(locale, "foot.disclaimer")}</p>
  </div>
</footer>
