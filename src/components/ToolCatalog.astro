---
/**
 * ToolCatalog: the public catalog of LinguaLab's tools.
 *
 * Everything here is decided at build time. The list is static and known when
 * the site compiles, so it is rendered on the server and the client never
 * fetches or builds a card: it only toggles what is already in the HTML. That
 * keeps the catalog readable without JavaScript and keeps the bundled script to
 * the two sentences it rewrites.
 *
 * The data arrives through the hexagon — `listTools` from the composition root,
 * which is wired to the `ToolRegistryPort` and its adapter — and not by reading
 * `src/data/tools.json` here. That keeps the page ignorant of where the catalog
 * is stored, which is the whole point of the port.
 */
import type { MessageKey, Locale } from "../i18n";
import { localePath, t } from "../i18n";
import type { ToolArea, ToolDescriptor, ToolIntegration, ToolStatus } from "@lingualab/core";
import { ANALYSIS_LEVELS } from "@lingualab/core";
import { SITE_ROUTES } from "../config/site";
import { AREA_KEYS, LANGUAGE_KEYS, STATUS_KEYS, hostOf, strongRuns } from "../config/catalog-labels";
import { lingualab } from "../composition-root";
import { CATALOG_STRING_KEYS, format } from "../scripts/catalogo/strings";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

/** The catalog can only fail if the registry is unavailable; say so instead of
 *  showing an empty page that would look like "there are no tools". */
const listed = await lingualab.listTools();
const tools: readonly ToolDescriptor[] = listed.ok ? listed.value : [];

/**
 * Internal routes of the tools that actually exist on this site. They live in
 * `src/config/site.ts` so a test can cross-check them against `tools.json`: a
 * card that claims to exist without a page promises something that is not there.
 * The catalog only links ids present in this map.
 */
const INTEGRATION_KEYS: Readonly<Record<ToolIntegration, MessageKey>> = {
  embedded: "catalog.integration.embedded",
  "external-link": "catalog.integration.externalLink",
  "needs-backend": "catalog.integration.needsBackend",
};

/** Stable tools read as healthy; experimental warns; planned adds a callout. */
const STATUS_BADGE: Readonly<Record<ToolStatus, string>> = {
  stable: "badge badge--ok",
  experimental: "badge badge--warn",
  planned: "badge",
};

const languageLabel = (code: string): string => {
  const key = LANGUAGE_KEYS[code];
  return key === undefined ? code : t(locale, key);
};

const notesOf = (tool: ToolDescriptor): string => tool.notes?.[locale] ?? "";

const languageLine = (tool: ToolDescriptor): string =>
  tool.languages.length === 0
    ? t(locale, "catalog.languageIndependent")
    : `${t(locale, "catalog.languages")}: ${tool.languages.map(languageLabel).join(", ")}`;

/* The options are derived from the data: an area nobody uses has no reason to
   occupy a row, and a tool added to the catalog appears in the filter for free. */
const areas = [...new Set(tools.map((tool) => tool.area))].sort();
const languages = [...new Set(tools.flatMap((tool) => tool.languages))].sort();
const integrations: readonly ToolIntegration[] = ["embedded", "external-link", "needs-backend"];

/**
 * Las herramientas agrupadas por nivel de analisis, en el orden de la disciplina.
 *
 * El orden NO se decide aca: viene de `ANALYSIS_LEVELS` en el nucleo, que es
 * donde la secuencia fonetica → documentacion es conocimiento linguistico y no
 * una preferencia de diseno. Un area sin herramientas no ocupa una seccion, y el
 * filtro de area esconde las secciones que se quedan vacias (ver el script).
 */
const byLevel = (subset: readonly ToolDescriptor[]) =>
  ANALYSIS_LEVELS.map((area) => ({
    area,
    tools: subset.filter((tool) => tool.area === area),
  })).filter((group) => group.tools.length > 0);

/* The two parts of the page: what opens here and what lives on another site.
   They never share a grid, so a reader can tell at a glance which is which. */
const parts = [
  {
    id: "integradas",
    kind: "here" as const,
    title: t(locale, "catalog.part.here"),
    intro: t(locale, "catalog.part.hereIntro"),
    tools: tools.filter((tool) => tool.integration !== "external-link"),
  },
  {
    id: "externas",
    kind: "away" as const,
    title: t(locale, "catalog.part.away"),
    intro: t(locale, "catalog.part.awayIntro"),
    tools: tools.filter((tool) => tool.integration === "external-link"),
  },
].map((part) => ({ ...part, groups: byLevel(part.tools) }));

/* The level index still lists every level that has a tool, in either part. */
const groups = byLevel(tools);

const anchorOf = (area: ToolArea): string => `nivel-${area}`;
const partAnchor = (part: string, area: ToolArea): string => `${part}-${area}`;

/* Runtime sentences for the filter script, already translated and keyed. */
const catalogStrings: Record<string, string> = {};
for (const key of CATALOG_STRING_KEYS) {
  catalogStrings[key] = t(locale, key);
}
---

<section class="section" data-catalog="true">
  <div class="shell">
    <!-- The dictionary subset reaches the script as data, never as inline code:
         the CSP is hash-based, so the script itself stays a static file. -->
    <div data-catalog-strings hidden data-json={JSON.stringify(catalogStrings)}></div>

    <div class="u-section-head">
      <h1>{t(locale, "catalog.title")}</h1>
      <p class="u-lead">{t(locale, "catalog.sub")}</p>
      <ul class="catalog__parts" role="list">
        {
          parts.map((part) => (
            <li>
              <a class={`catalog__part-link catalog__part-link--${part.kind}`} href={`#${part.id}`}>
                {part.title} <span class="catalog__part-count">{part.tools.length}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="catalog__privacy">{t(locale, "catalog.privacy")}</p>
    </div>

    {!listed.ok && <p class="callout callout--warn">{t(locale, "catalog.error")}</p>}

    <div class="cluster">
      <label for="catalog-area">
        <span class="faint">{t(locale, "catalog.filter.area")}</span>
        <select
          id="catalog-area"
          data-catalog-filter="area"
          data-catalog-label={t(locale, "catalog.filter.area")}
        >
          <option value="">{t(locale, "catalog.filter.allAreas")}</option>
          {areas.map((area) => <option value={area}>{t(locale, AREA_KEYS[area])}</option>)}
        </select>
      </label>

      <label for="catalog-language">
        <span class="faint">{t(locale, "catalog.filter.language")}</span>
        <select
          id="catalog-language"
          data-catalog-filter="language"
          data-catalog-label={t(locale, "catalog.filter.language")}
        >
          <option value="">{t(locale, "catalog.filter.allLanguages")}</option>
          {
            languages.map((language) => (
              <option value={language}>{languageLabel(language)}</option>
            ))
          }
        </select>
      </label>

      <label for="catalog-integration">
        <span class="faint">{t(locale, "catalog.filter.integration")}</span>
        <select
          id="catalog-integration"
          data-catalog-filter="integration"
          data-catalog-label={t(locale, "catalog.filter.integration")}
        >
          <option value="">{t(locale, "catalog.filter.allIntegrations")}</option>
          {
            integrations.map((integration) => (
              <option value={integration}>{t(locale, INTEGRATION_KEYS[integration])}</option>
            ))
          }
        </select>
      </label>
    </div>

    <!-- Indice de niveles: un salto directo a cada seccion, sin JavaScript y sin
         depender del filtro. Los anchors son estables (`#nivel-fonologia`) para
         que se puedan citar desde cualquier otro documento. -->
    <nav class="catalog__index" aria-labelledby="catalog-levels">
      <p class="eyebrow" id="catalog-levels">{t(locale, "catalog.levels")}</p>
      <ul class="catalog__index-list">
        {
          groups.map((group) => (
            <li>
              <a href={`#${anchorOf(group.area)}`}>{t(locale, AREA_KEYS[group.area])}</a>
            </li>
          ))
        }
      </ul>
      <p class="faint">{t(locale, "catalog.levelNote")}</p>
    </nav>

    <!-- One live region carries the count; the empty state below explains WHY
         nothing matched, so the two never repeat the same sentence. -->
    <p class="faint" role="status" aria-live="polite" data-catalog-count>
      {format(t(locale, "catalog.count"), { count: tools.length, total: tools.length })}
    </p>
    <p class="callout" data-catalog-empty hidden></p>

    {
      parts.map((part) => (
        <section
          class={`catalog__part catalog__part--${part.kind}`}
          id={part.id}
          data-catalog-group
          aria-labelledby={`${part.id}-title`}
        >
          <header class="catalog__part-head">
            <h2 id={`${part.id}-title`}>
              {part.title} <span class="catalog__part-count">{part.tools.length}</span>
            </h2>
            <p>{part.intro}</p>
          </header>

          {part.groups.map((group) => (
            <section
              class="catalog__group"
              data-catalog-group
              id={partAnchor(part.id, group.area)}
              aria-labelledby={`${partAnchor(part.id, group.area)}-title`}
            >
              {/* The level anchors (#nivel-…) point at the first part that has
                  the level, so links cited elsewhere keep working. */}
              {parts.find((first) => first.groups.some((g) => g.area === group.area))?.id === part.id ? (
                <span id={anchorOf(group.area)} class="catalog__anchor" />
              ) : null}
              <h3 class="catalog__group-title" id={`${partAnchor(part.id, group.area)}-title`}>
                {t(locale, AREA_KEYS[group.area])}
              </h3>

              <div class="grid" role="list">
                {group.tools.map((tool) => {
                  const route = SITE_ROUTES[tool.id];
                  const planned = tool.status === "planned";
                  return (
                    <article
                      class={`card catalog-card catalog-card--${part.kind}`}
                      role="listitem"
                      data-tool-card
                      data-status={tool.status}
                      data-area={tool.area}
                      data-integration={tool.integration}
                      data-languages={tool.languages.join(" ")}
                    >
                      {tool.status !== "stable" && (
                        <div class="cluster">
                          <span class={STATUS_BADGE[tool.status]}>
                            {t(locale, STATUS_KEYS[tool.status])}
                          </span>
                        </div>
                      )}

                      {/* A planned card must not look like a working one: it is not a
                          link and carries its own warning. */}
                      {planned && (
                        <p class="callout callout--warn" data-planned-mark>
                          {t(locale, "catalog.plannedMark")}
                        </p>
                      )}

                      <h4 class="card__title">
                        {route ? (
                          <a href={localePath(locale, route)}>{tool.name[locale]}</a>
                        ) : (
                          tool.name[locale]
                        )}
                      </h4>

                      <p class="card__body">
                        {strongRuns(notesOf(tool)).map((run) => (run.strong ? <strong>{run.text}</strong> : run.text))}
                      </p>
                      <p class="catalog-card__langs">{languageLine(tool)}</p>

                      {tool.citation && (
                        <details class="catalog-card__cite">
                          <summary>{t(locale, "catalog.cite")}</summary>
                          <p class="card__body">{tool.citation}</p>
                        </details>
                      )}

                      {route && <p class="card__cta">{t(locale, "catalog.open")}</p>}

                      {/* An external tool opens, it is not navigated to: target and
                          rel, and the new-tab notice inside the link's accessible
                          name. The host says where it goes before you click. */}
                      {tool.url && (
                        <p class="card__cta card__cta--ext">
                          <a href={tool.url} target="_blank" rel="noopener noreferrer" data-external>
                            {t(locale, "catalog.externalLink")} <span aria-hidden="true">↗</span>
                            <span class="u-visually-hidden">
                              {" "}
                              {t(locale, "catalog.externalNewTab")}
                            </span>
                          </a>
                          <span class="catalog-card__host">{hostOf(tool.url)}</span>
                        </p>
                      )}
                    </article>
                  );
                })}
              </div>
            </section>
          ))}
        </section>
      ))
    }
  </div>
</section>

<script>
  import { initToolCatalog } from "../scripts/catalogo/index";
  import { safeInit } from "../scripts/core/safe";

  // A broken filter must not take the page down with it: safeInit contains the
  // failure and names the widget in the console.
  safeInit("tool catalog", initToolCatalog);
</script>
