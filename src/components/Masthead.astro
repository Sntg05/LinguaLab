---
/**
 * Site masthead: brand, primary navigation, language and theme controls.
 * Server-rendered; the disclosure and theme toggle are progressive
 * enhancements layered on top of working links and a working <html lang>.
 *
 * Only the primary navigation items are rendered here. Reference pages live
 * in the footer, which keeps the header to the four tools and the two
 * controls.
 */
import { PRIMARY_NAV_ITEMS } from "../config/site";
import { DEFAULT_LOCALE, LOCALES, LOCALE_NAMES, localePath, t, type Locale } from "../i18n";
import Brand from "./Brand.astro";

interface Props {
  locale?: Locale;
  /** Current route in the default locale, for aria-current. */
  path?: string;
}

const { locale = DEFAULT_LOCALE, path = "/" } = Astro.props;
const isCurrent = (candidate: string) => candidate === path;
---

<header class="masthead" data-masthead>
  <div class="shell masthead__inner">
    <Brand locale={locale} />

    <button
      class="nav__toggle"
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label={t(locale, "nav.menu")}
    >
      <span class="nav__toggle-lines" aria-hidden="true"></span>
    </button>

    <nav class="nav" id="primary-nav" data-nav data-open="false" aria-label={t(locale, "nav.menu")}>
      {
        PRIMARY_NAV_ITEMS.map((item) => (
          <a
            class="nav__link"
            href={localePath(locale, item.path)}
            aria-current={isCurrent(item.path) ? "page" : undefined}
          >
            {t(locale, item.labelKey)}
          </a>
        ))
      }

      <div class="nav__controls cluster">
        <div class="segmented" role="group" aria-label={t(locale, "nav.lang")}>
          {
            LOCALES.map((l) => (
              <a
                class="segmented__btn"
                href={localePath(l, path)}
                lang={l}
                hreflang={l}
                aria-current={l === locale ? "true" : undefined}
                title={LOCALE_NAMES[l]}
                style={l === locale ? "" : undefined}
                aria-pressed={l === locale ? "true" : "false"}
              >
                {l.toUpperCase()}
              </a>
            ))
          }
        </div>

        {/* The script reads the per-state labels from the data attributes
            below, because it runs in the browser where the build-time
            translations are no longer reachable. */}
        <button
          class="icon-btn"
          type="button"
          data-theme-toggle
          data-theme-label-auto={t(locale, "nav.themeAuto")}
          data-theme-label-light={t(locale, "nav.themeLight")}
          data-theme-label-dark={t(locale, "nav.themeDark")}
          aria-live="polite"
          aria-label={t(locale, "nav.theme")}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" data-theme-icon>
            <path
              d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </nav>
  </div>
</header>
