---
/**
 * AudioLab: visor de audio con espectrograma, anotacion por intervalos y
 * TextGrid de Praat.
 *
 * QUE HACE Y QUE NO PROMETE
 *
 * Reproduce, dibuja la onda y el espectrograma, permite anotar capas de
 * intervalos y guarda el trabajo en este navegador. Importa y exporta TextGrid y
 * exporta CSV. No hace analisis acustico (F0, formantes): eso es el segmento 8, y
 * fingirlo aqui seria prometer lo que no se midio.
 *
 * NADA SALE DEL EQUIPO. El audio no se sube a ningun sitio: `decodeAudioData`
 * trabaja sobre un `ArrayBuffer` que ya esta en memoria, y la unica salida son
 * los archivos que la persona descarga. El aviso esta escrito en la pagina, no
 * solo en el README (ADR 0002).
 *
 * SIN wavesurfer.js, Y POR QUE
 *
 * El prompt del segmento pide wavesurfer.js con sus plugins. Se descarto: la
 * libreria con regiones, espectrograma y linea de tiempo pesa mas que el
 * presupuesto ENTERO de la pagina (60 KB comprimidos, medido por
 * `scripts/verify-build.mjs`), y este repositorio no puede verificar la API real
 * de una version que nadie ha probado aqui. Lo que hacia falta —onda, regiones,
 * espectrograma, regla de tiempo— se resuelve con canvas y una FFT de cincuenta
 * lineas, que ademas se puede probar.
 *
 * El marcado lleva `data-audio-*` porque `src/scripts/audio/index.ts` trabaja por
 * delegacion sobre esos ganchos; ninguna etiqueta visible se construye con
 * `innerHTML`, asi que la CSP sin `unsafe-inline` no se toca.
 */
import { t, type Locale } from "../i18n";
import { ACOUSTIC_STRING_KEYS } from "../scripts/audio/acoustic-strings";
import { AUDIO_STRING_KEYS } from "../scripts/audio/strings";
import "../styles/features/acoustic.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === "es";

/**
 * Solo las cadenas que el controlador necesita escribir mientras trabaja. Se
 * serializan ya traducidas: el diccionario completo no viaja al navegador (ver
 * `src/i18n/index.ts`).
 */
const runtimeStrings = Object.fromEntries(
  AUDIO_STRING_KEYS.map((key) => [key, t(locale, key)]),
);

/**
 * Lo mismo para los paneles acústicos, en su propio atributo: son dos
 * controladores distintos y cada uno recibe solo las frases que escribe.
 */
const acousticStrings = Object.fromEntries(
  ACOUSTIC_STRING_KEYS.map((key) => [key, t(locale, key)]),
);

const WINDOWS = [
  { value: "0.005", label: "5 ms" },
  { value: "0.01", label: "10 ms" },
  { value: "0.015", label: "15 ms" },
  { value: "0.025", label: "25 ms" },
  { value: "0.032", label: "32 ms" },
];
---

<section class="section" data-audiolab data-audiolab-strings={JSON.stringify(runtimeStrings)}>
  <div class="shell">
    <div class="u-section-head">
      <span class="eyebrow">{es ? "Visor" : "Viewer"}</span>
      <h1>{t(locale, "audio.title")}</h1>
      <p class="u-lead">{t(locale, "audio.sub")}</p>
      <!-- El aviso de privacidad va visible: quien abre una herramienta tiene que
           poder saber, sin buscarlo, que su grabacion no sale del equipo. -->
      <p class="callout">{t(locale, "audio.privacy")}</p>
      <p class="callout callout--warn">{t(locale, "audio.experimental")}</p>
    </div>

    <div class="audiolab">
      <!-- Barra del editor: cargar y reproducir en una barra compacta encima de los
           lienzos, como la de una ventana de Praat, para que barra, onda,
           espectrograma y capas quepan en una pantalla (unidades 5.1 y 5.8). -->
      <div class="audiolab__editor">
      <div class="panel audiolab__bar" data-audio-bar>
        <h2 class="u-visually-hidden">{t(locale, "audio.bar.title")}</h2>
        {/* Un solo `label` por control: si el texto de arriba fuera un segundo
            `label`, axe marca `form-field-multiple-labels` y el lector de
            pantalla lee dos nombres. El nombre es el del botón («Elegir
            archivo»); «Archivo de audio» queda como descripción. Las
            descripciones van fuera de la fila: dentro, aun invisibles, ocupan un
            hueco del `gap` y parten la fila en dos. */}
        <span class="u-visually-hidden" id="audio-file-label">{t(locale, "audio.load.pick")}</span>
        <span class="u-visually-hidden" id="audio-rate-note">0.5× – 2×</span>
        <div class="cluster">
          <label class="btn btn--quiet u-file">
            {t(locale, "file.choose")}
            <input
              class="u-visually-hidden"
              id="audio-file"
              type="file"
              data-audio-file
              aria-describedby="audio-file-label"
              accept="audio/*,.wav,.mp3,.ogg,.oga,.opus,.m4a,.flac,.webm"
            />
          </label>
          <button class="btn btn--primary" type="button" data-audio-play aria-pressed="false">
            {t(locale, "audio.play")}
          </button>
          <button class="btn btn--quiet" type="button" data-audio-stop>
            {t(locale, "audio.stop")}
          </button>
          <label class="field field--inline">
            <span class="field__label">{t(locale, "audio.rate")}</span>
            <input
              type="range"
              data-audio-rate
              min="0.5"
              max="2"
              step="0.1"
              value="1"
              aria-describedby="audio-rate-note"
            />
          </label>
          <label class="field field--inline">
            <input type="checkbox" data-audio-loop />
            <span class="field__label">{t(locale, "audio.loop")}</span>
          </label>
          <button class="btn btn--quiet btn--sm" type="button" data-audio-zoom-in>
            {t(locale, "audio.zoomIn")}
          </button>
          <button class="btn btn--quiet btn--sm" type="button" data-audio-zoom-out>
            {t(locale, "audio.zoomOut")}
          </button>
          <button class="btn btn--quiet btn--sm" type="button" data-audio-pan-left>
            {t(locale, "audio.panLeft")}
          </button>
          <button class="btn btn--quiet btn--sm" type="button" data-audio-pan-right>
            {t(locale, "audio.panRight")}
          </button>
        </div>

        <div class="audiolab__cursor">
          <label class="field__label" for="audio-cursor">{t(locale, "audio.cursor")}</label>
          <input
            id="audio-cursor"
            type="range"
            data-audio-cursor
            min="0"
            max="1"
            step="0.001"
            value="0"
            disabled
          />
          <output class="audiolab__readout" data-audio-cursor-readout>0.000 s</output>
        </div>
        <p class="audiolab__status" data-audio-status role="status" aria-live="polite" data-state="idle">
          {t(locale, "audio.status.idle")}
        </p>
      </div>

      <!-- --------------------------- Canvas ---------------------------- -->
      {/* El marco es el editor: recibe el foco (un clic en un lienzo lo enfoca) y
          con el foco dentro valen los atajos de Praat: Intro, Supr y Tab. */}
      <div
        class="audiolab__canvas"
        data-audio-canvas
        tabindex="0"
        role="group"
        aria-label={t(locale, "audio.editor.label")}
        aria-describedby="audio-editor-hint">
        <div class="audiolab__label">
          <label class="field__label" for="audio-label">{t(locale, "audio.label.title")}</label>
          <input
            id="audio-label"
            class="audiolab__label-input"
            type="text"
            data-audio-label
            autocomplete="off"
            spellcheck="false"
            disabled
          />
        </div>
        <canvas
          class="audiolab__wave"
          data-audio-wave
          role="img"
          aria-label={t(locale, "audio.canvas.wave")}></canvas>
        <canvas
          class="audiolab__spec"
          data-audio-spec
          role="img"
          aria-label={t(locale, "audio.canvas.spec")}></canvas>
        <canvas
          class="audiolab__tiers"
          data-audio-tiers
          role="img"
          aria-label={t(locale, "audio.canvas.tiers")}></canvas>
        <p class="faint" id="audio-editor-hint">{t(locale, "audio.canvas.note")}</p>
      </div>
      </div>

      <!-- ------------------------ Espectrograma ------------------------ -->
      <div class="panel">
        <h2 class="panel__title">{t(locale, "audio.spectrogram.title")}</h2>
        <div class="cluster">
          <label class="field field--inline">
            <input type="checkbox" data-audio-spectrogram checked />
            <span class="field__label">{t(locale, "audio.spectrogram.toggle")}</span>
          </label>
          <label class="field field--inline">
            <span class="field__label">{t(locale, "audio.window")}</span>
            <select data-audio-window>
              {
                WINDOWS.map((option) => (
                  <option value={option.value} selected={option.value === "0.005"}>
                    {option.label}
                  </option>
                ))
              }
            </select>
          </label>
          <label class="field field--inline">
            <span class="field__label">{t(locale, "audio.fmax")}</span>
            <input type="number" data-audio-fmax min="500" max="22050" step="100" value="5000" />
          </label>
          <label class="field field--inline">
            <span class="field__label">{t(locale, "audio.fmin")}</span>
            <input type="number" data-audio-fmin min="0" max="21000" step="100" value="0" />
          </label>
          <label class="field field--inline">
            <span class="field__label">{t(locale, "audio.scale")}</span>
            <select data-audio-scale>
              <option value="gray">{t(locale, "audio.scaleGray")}</option>
              <option value="color">{t(locale, "audio.scaleColor")}</option>
            </select>
          </label>
          <span class="badge badge--warn">{t(locale, "audio.experimentalBadge")}</span>
        </div>
        <p class="faint">{t(locale, "audio.spectrogram.note")}</p>
      </div>

      <!-- ----------------------- Análisis acústico --------------------- -->
      <!--
        El aviso de experimental va ARRIBA del panel y no al pie: la condición
        para quitarlo es el contraste contra Praat sobre voces reales, y ese
        contraste todavía no existe (docs/validation/acoustic.md). El texto se
        pide al diccionario, no se escribe aquí: hay dos idiomas.
      -->
      <div
        class="panel acoustic"
        data-acoustic
        data-acoustic-strings={JSON.stringify(acousticStrings)}
      >
        <h2 class="panel__title">{t(locale, "acoustic.title")}</h2>
        <p class="faint">{t(locale, "acoustic.lead")}</p>
        <p class="callout callout--warn">{t(locale, "acoustic.experimental")}</p>
        <p
          class="audiolab__status"
          data-acoustic-status
          role="status"
          aria-live="polite"
          data-state="idle"
        >
          {t(locale, "acoustic.status.idle")}
        </p>

        <h3 class="acoustic__subtitle">{t(locale, "acoustic.pitch.title")}</h3>
        <div class="cluster">
          <label class="field field--inline">
            <span class="field__label">{t(locale, "acoustic.preset.label")}</span>
            <select data-acoustic-preset>
              <option value="" selected>{t(locale, "acoustic.preset.custom")}</option>
              <option value="masculine">{t(locale, "acoustic.preset.masculine")}</option>
              <option value="feminine">{t(locale, "acoustic.preset.feminine")}</option>
              <option value="child">{t(locale, "acoustic.preset.child")}</option>
            </select>
          </label>
          <label class="field field--inline">
            <span class="field__label">{t(locale, "acoustic.pitch.floor")}</span>
            <input
              type="number"
              data-acoustic-pitch-floor
              min="20"
              max="2000"
              step="5"
              value="75"
            />
          </label>
          <label class="field field--inline">
            <span class="field__label">{t(locale, "acoustic.pitch.ceiling")}</span>
            <input
              type="number"
              data-acoustic-pitch-ceiling
              min="40"
              max="3000"
              step="10"
              value="600"
            />
          </label>
          <button class="btn btn--primary btn--sm" type="button" data-acoustic-pitch-run>
            {t(locale, "acoustic.pitch.run")}
          </button>
        </div>
        <p class="faint">{t(locale, "acoustic.pitch.note")}</p>
        <canvas
          class="acoustic__plot"
          data-acoustic-f0-canvas
          role="img"
          aria-label={t(locale, "acoustic.canvas.f0")}></canvas>

        <h3 class="acoustic__subtitle">{t(locale, "acoustic.formant.title")}</h3>
        <div class="cluster">
          <label class="field field--inline">
            <span class="field__label">{t(locale, "acoustic.formant.max")}</span>
            <input
              type="number"
              data-acoustic-formant-max
              min="1000"
              max="12000"
              step="100"
              value="5500"
            />
          </label>
          <button class="btn btn--primary btn--sm" type="button" data-acoustic-formant-run>
            {t(locale, "acoustic.formant.run")}
          </button>
          <label class="field field--inline">
            <input type="checkbox" data-acoustic-formant-overlay />
            <span class="field__label">{t(locale, "acoustic.formant.overlay")}</span>
          </label>
        </div>
        <p class="faint">{t(locale, "acoustic.formant.note")}</p>

        <h3 class="acoustic__subtitle">{t(locale, "acoustic.intensity.title")}</h3>
        <div class="cluster">
          <button class="btn btn--primary btn--sm" type="button" data-acoustic-intensity-run>
            {t(locale, "acoustic.intensity.run")}
          </button>
        </div>
        <p class="faint">{t(locale, "acoustic.intensity.note")}</p>
        <canvas
          class="acoustic__plot"
          data-acoustic-intensity-canvas
          role="img"
          aria-label={t(locale, "acoustic.canvas.intensity")}></canvas>

        <h3 class="acoustic__subtitle">{t(locale, "acoustic.measure.title")}</h3>
        <div class="cluster">
          <button class="btn btn--primary btn--sm" type="button" data-acoustic-measure-run>
            {t(locale, "acoustic.measure.run")}
          </button>
          <button class="btn btn--quiet btn--sm" type="button" data-acoustic-measure-export disabled>
            {t(locale, "acoustic.measure.export")}
          </button>
          <button class="btn btn--quiet btn--sm" type="button" data-acoustic-measure-clear disabled>
            {t(locale, "acoustic.measure.clear")}
          </button>
        </div>
        <p class="faint">{t(locale, "acoustic.measure.note")}</p>
        <p class="faint" data-acoustic-measure-empty>{t(locale, "acoustic.measure.empty")}</p>
        {/* Una región que se desplaza tiene que poder enfocarse con el teclado y
            tener nombre: si no, quien navega sin ratón no puede recorrer la
            tabla. Lo encontró axe en esta tabla (`scrollable-region-focusable`,
            impacto serio) cuando la medición acústica la llenó de columnas. */}
        <div
          class="audiolab__table-wrap"
          tabindex="0"
          role="region"
          aria-label={t(locale, "acoustic.measure.title")}
        >
          {/* Una tabla con encabezados y sin filas hace que axe no pueda decidir
              (`th-has-data-cells`, sin motivo): se esconde hasta tener datos, y
              el texto de vacío de arriba explica por qué. */}
          <table class="audiolab__table acoustic__table" data-acoustic-measure-table hidden>
            <caption class="faint">{t(locale, "acoustic.measure.title")}</caption>
            <thead>
              <tr>
                <th scope="col" rowspan="2">{t(locale, "acoustic.measure.head.label")}</th>
                <th scope="col" rowspan="2">{t(locale, "acoustic.measure.head.range")}</th>
                <th scope="colgroup" colspan="4">{t(locale, "acoustic.measure.head.f0")}</th>
                <th scope="col" rowspan="2">{t(locale, "acoustic.measure.head.intensity")}</th>
                <th scope="colgroup" colspan="4">{t(locale, "acoustic.measure.head.f1")}</th>
                <th scope="colgroup" colspan="4">{t(locale, "acoustic.measure.head.f2")}</th>
              </tr>
              <tr>
                <th scope="col">{t(locale, "acoustic.measure.head.mean")}</th>
                <th scope="col">{t(locale, "acoustic.measure.head.median")}</th>
                <th scope="col">{t(locale, "acoustic.measure.head.min")}</th>
                <th scope="col">{t(locale, "acoustic.measure.head.max")}</th>
                <th scope="col">{t(locale, "acoustic.measure.head.percent25")}</th>
                <th scope="col">{t(locale, "acoustic.measure.head.percent50")}</th>
                <th scope="col">{t(locale, "acoustic.measure.head.percent75")}</th>
                <th scope="col">{t(locale, "acoustic.measure.head.centre")}</th>
                <th scope="col">{t(locale, "acoustic.measure.head.percent25")}</th>
                <th scope="col">{t(locale, "acoustic.measure.head.percent50")}</th>
                <th scope="col">{t(locale, "acoustic.measure.head.percent75")}</th>
                <th scope="col">{t(locale, "acoustic.measure.head.centre")}</th>
              </tr>
            </thead>
            <tbody data-acoustic-measure-body></tbody>
          </table>
        </div>

        <h3 class="acoustic__subtitle">{t(locale, "acoustic.vowels.title")}</h3>
        <p class="faint" data-acoustic-vowels-empty>{t(locale, "acoustic.vowels.empty")}</p>
        <canvas
          class="acoustic__plot acoustic__plot--vowels"
          data-acoustic-vowels-canvas
          role="img"
          aria-label={t(locale, "acoustic.canvas.vowels")}></canvas>
        <p class="faint">{t(locale, "acoustic.limits")}</p>
      </div>

      <!-- -------------------------- Segmentar -------------------------- -->
      {/* Unidad 5.8 del rework v4: lo que hace falta en la primera clase, a la vista
          (capa, poner limite, moverse, deshacer, el teclado AFI); lo demas, plegado.
          La tabla se conserva: es el equivalente accesible del lienzo. */}
      <div class="panel" data-audio-segment>
        <h2 class="panel__title">{t(locale, "audio.segment.title")}</h2>
        <div class="cluster">
          <label class="field field--inline">
            <span class="field__label">{t(locale, "audio.tier.active")}</span>
            <select data-audio-tier></select>
          </label>
          <button class="btn btn--primary btn--sm" type="button" data-audio-interval-split>
            {t(locale, "audio.interval.split")}
          </button>
          <button class="btn btn--quiet btn--sm" type="button" data-audio-interval-prev>
            {t(locale, "audio.interval.prev")}
          </button>
          <button class="btn btn--quiet btn--sm" type="button" data-audio-interval-next>
            {t(locale, "audio.interval.next")}
          </button>
          <button class="btn btn--quiet btn--sm" type="button" data-audio-undo>
            {t(locale, "audio.history.undo")}
          </button>
          <button class="btn btn--quiet btn--sm" type="button" data-audio-redo>
            {t(locale, "audio.history.redo")}
          </button>
          <button class="btn btn--quiet btn--sm" type="button" data-audio-tier-add>
            {t(locale, "audio.tier.add")}
          </button>
        </div>
        <p class="faint">{t(locale, "audio.segment.scope")}</p>

        <details class="audiolab__more" data-audio-ipa-panel>
          <summary>{t(locale, "audio.ipa.title")}</summary>
          <p class="faint">{t(locale, "audio.ipa.note")}</p>
          <div class="audiolab__ipa" data-audio-ipa></div>
        </details>

        <details class="audiolab__more" data-audio-tier-more>
          <summary>{t(locale, "audio.tier.more")}</summary>
          <div class="cluster">
            <label class="field field--inline">
              <span class="field__label">{t(locale, "audio.tier.name")}</span>
              <input type="text" data-audio-tier-name aria-describedby="audio-tier-note" />
            </label>
            <button class="btn btn--quiet btn--sm" type="button" data-audio-tier-remove>
              {t(locale, "audio.tier.remove")}
            </button>
            <button class="btn btn--quiet btn--sm" type="button" data-audio-tier-up>
              {t(locale, "audio.tier.up")}
            </button>
            <button class="btn btn--quiet btn--sm" type="button" data-audio-tier-down>
              {t(locale, "audio.tier.down")}
            </button>
          </div>
          <p class="faint" id="audio-tier-note">{t(locale, "audio.tier.note")}</p>
        </details>

        <details class="audiolab__more" data-audio-table>
          <summary>{t(locale, "audio.table.show")}</summary>
          <p class="faint">{t(locale, "audio.intervals.note")}</p>
          {/* Misma razón que en la tabla de mediciones: el contenedor se desplaza
              en horizontal y tiene que poder recorrerse con el teclado. */}
          <div
            class="audiolab__table-wrap"
            tabindex="0"
            role="region"
            aria-label={t(locale, "audio.intervals.caption")}
          >
            <table class="audiolab__table">
              <caption>
                <span class="field__label">{t(locale, "audio.intervals.caption")}</span>
                <span class="audiolab__caption-tier" data-audio-intervals-caption></span>
              </caption>
              <thead>
                <tr>
                  <th scope="col">{t(locale, "audio.intervals.head.index")}</th>
                  <th scope="col">{t(locale, "audio.intervals.head.start")}</th>
                  <th scope="col">{t(locale, "audio.intervals.head.end")}</th>
                  <th scope="col">{t(locale, "audio.intervals.head.text")}</th>
                  <th scope="col">{t(locale, "audio.intervals.head.actions")}</th>
                </tr>
              </thead>
              <tbody data-audio-intervals></tbody>
            </table>
          </div>
        </details>
      </div>


      <!-- ------------------------ Datos y archivos --------------------- -->
      <div class="panel">
        <h2 class="panel__title">{t(locale, "audio.data.title")}</h2>
        <div class="field">
          <label class="field__label" for="audio-project">{t(locale, "audio.data.project")}</label>
          <input id="audio-project" type="text" data-audio-project value="visor" />
        </div>
        <p class="faint" data-audio-save-note role="status" aria-live="polite"></p>
        <p class="faint" data-audio-persistence></p>

        <!-- Los proyectos guardados se pueden BORRAR. Sin este control, la unica
             forma de liberar espacio era borrar los datos del navegador a mano,
             y la degradacion por cuota quedaba sin salida. La confirmacion vive
             en el propio control y no en `window.confirm`: un dialogo del
             navegador no se puede etiquetar, no se lee con el estilo de la
             pagina y en un lector de pantalla aparece fuera de contexto. -->
        <div class="audiolab__projects" data-audio-projects>
          <p class="faint" data-audio-projects-count></p>
          <div class="cluster">
            <button class="btn btn--quiet btn--sm" type="button" data-audio-projects-clear>
              {t(locale, "audio.projects.clear")}
            </button>
          </div>
          <div class="audiolab__confirm" data-audio-projects-confirm hidden>
            <p class="faint" data-audio-projects-confirm-text></p>
            <div class="cluster">
              <button
                class="btn btn--primary btn--sm"
                type="button"
                data-audio-projects-clear-confirm
              >
                {t(locale, "audio.projects.clearConfirm")}
              </button>
              <button class="btn btn--quiet btn--sm" type="button" data-audio-projects-cancel>
                {t(locale, "audio.projects.cancel")}
              </button>
            </div>
          </div>
        </div>

        <div class="cluster">
          <button class="btn btn--primary btn--sm" type="button" data-audio-export-textgrid>
            {t(locale, "audio.data.exportTextGrid")}
          </button>
          <button class="btn btn--quiet btn--sm" type="button" data-audio-export-csv>
            {t(locale, "audio.data.exportCsv")}
          </button>
        </div>

        <div class="field">
          <span class="field__label" id="audio-textgrid-file-label">
            {t(locale, "audio.data.importTextGrid")}
          </span>
