---
/**
 * PhonemizerLab: text → IPA for Spanish and English.
 *
 * Two methods answer the same text and the page shows both. The site's own
 * transcriber (rules for Spanish, the CMUdict dictionary for English) gives the
 * reference transcription. Next to it sits the grapheme-to-IPA rule table from
 * the orthography tool, one demo table per language: the disagreement between
 * the two is visible instead of argued away in a footnote.
 *
 * The language list is asked of the port (`listLanguages`) rather than written
 * into the markup, so the selector cannot offer a language the engine would
 * refuse. Variety and level only exist for Spanish, so their selectors are
 * hidden for any other language.
 *
 * The engine is not imported here: `src/composition-root.ts` wires it. This
 * page ships no dictionary; it is fetched the first time someone transcribes
 * English.
 */
import { DEMO_TABLES } from "@lingualab/core";
import { lingualab } from "../composition-root";
import { t, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === "es";

/**
 * Display names for the languages the port admits, keyed by the ISO 639-3 code
 * the port speaks. Anything the port later adds without a name here falls back
 * to its code, because an invented name would be worse than the truth.
 */
const LANGUAGE_NAMES: Readonly<Record<string, { es: string; en: string }>> = {
  spa: { es: "Español", en: "Spanish" },
  eng: { es: "Inglés", en: "English" },
  // Las demos de ortografía añadieron dos lenguas más, y esta comparación las
  // recorre desde DEMO_TABLES: sin nombre, la frase mostraba el código ISO
  // (por, guc) en lugar de la lengua, que es lo mismo que no decir nada.
  por: { es: "Portugués", en: "Portuguese" },
  guc: { es: "Wayuunaiki", en: "Wayuunaiki" },
};

const languages = lingualab.phonemizer.listLanguages();
const nameOf = (code: string): string => LANGUAGE_NAMES[code]?.[locale] ?? code;

/** The languages the comparison can actually show, taken from the tables. */
const comparisonLanguages = [...new Set(DEMO_TABLES.map((table) => nameOf(table.languageId)))];
---

<section class="section" data-phonemizer="true">
  <div class="shell">
    <div class="u-section-head">
      <span class="eyebrow">{es ? "Fonemizador" : "Phonemizer"}</span>
      <h1>{t(locale, "phon.title")}</h1>
      <p class="u-lead">{t(locale, "phon.sub")}</p>
      <!-- Two things the tool must never hide: that nothing is uploaded, and
           that the IPA it produces is approximate. Both are visible here, not
           buried in a help page. -->
      <p class="callout">{t(locale, "phon.local")}</p>
      <p class="callout callout--warn">{t(locale, "phon.warn")}</p>
    </div>

    <div class="phon">
      <div class="phon__input">
        <div class="field">
          <label class="field__label" for="phon-text">{t(locale, "phon.text")}</label>
          <textarea
            id="phon-text"
            data-phon-text
            rows="4"
            spellcheck="false"
            placeholder={es ? "Escribe una frase…" : "Type a phrase…"}></textarea>
        </div>

        <div class="cluster">
          <label class="field field--inline">
            <span class="field__label">{t(locale, "phon.language")}</span>
            <select data-phon-lang>
              {
                languages.map((code) => (
                  <option value={code}>{nameOf(code)}</option>
                ))
              }
            </select>
          </label>

          <label class="field field--inline" data-phon-spanish-only>
            <span class="field__label">{t(locale, "phon.variety")}</span>
            <select data-phon-variety>
              <option value="latin-american">{t(locale, "phon.varietyLatam")}</option>
              <option value="castilian">{t(locale, "phon.varietyCastilian")}</option>
            </select>
          </label>

          <label class="field field--inline" data-phon-spanish-only>
            <span class="field__label">{t(locale, "phon.level")}</span>
            <select data-phon-level>
              <option value="phonemic">{t(locale, "phon.levelPhonemic")}</option>
              <option value="phonetic">{t(locale, "phon.levelPhonetic")}</option>
            </select>
          </label>

          <button class="btn btn--primary" type="button" data-phon-run>
            {t(locale, "phon.run")}
          </button>
          <button class="btn btn--quiet" type="button" data-phon-clear>
            {t(locale, "phon.clear")}
          </button>
        </div>

        <p class="phon__status" data-phon-status role="status" aria-live="polite" data-state="idle">
          {es ? "Escribe un texto y pulsa «Fonemizar»." : "Type a text and press “Phonemize”."}
        </p>
        <p class="faint">{t(locale, "phon.limits")}</p>
      </div>

      <!-- ---------------- Results ---------------- -->
      <div class="phon__outputs" data-phon-outputs>
        <div class="panel">
          <div class="cluster">
            <h2 class="panel__title">{t(locale, "phon.engine")}</h2>
            <span class="badge" data-phon-engine></span>
          </div>
          <output class="data-surface ipa phon__ipa" data-phon-ipa aria-live="polite">—</output>
          <!-- What the engine could not resolve is shown, never hidden: a word
               outside the dictionary has no transcription, and a word with two
               readings does not have just one. -->
          <div class="phon__notes" data-phon-skipped-box hidden>
            <h3 class="phon__notes-title">{t(locale, "phon.skipped")}</h3>
            <p class="faint" data-phon-skipped></p>
          </div>
          <div class="phon__notes" data-phon-variants-box hidden>
            <h3 class="phon__notes-title">{t(locale, "phon.variants")}</h3>
            <ul class="phon__variants ipa" data-phon-variants></ul>
          </div>
          <div class="cluster">
            <button class="btn btn--quiet btn--sm" type="button" data-phon-copy disabled>
              {t(locale, "phon.copy")}
            </button>
            <span class="faint" role="status" aria-live="polite" data-phon-copy-note></span>
          </div>
        </div>

        <div class="panel">
          <h2 class="panel__title">{t(locale, "phon.table")}</h2>
          <p class="faint">{t(locale, "phon.tableNote")}</p>
          <output class="data-surface ipa phon__ipa" data-phon-table aria-live="polite">—</output>
          <p class="faint" data-phon-table-name></p>
          <p class="faint">
            {es ? "Comparación disponible para" : "Comparison available for"}:
            {comparisonLanguages.join(", ")}.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<p class="u-visually-hidden" role="status" aria-live="polite" data-live-region></p>

<script>
  import { initPhonemizerLab } from "../scripts/phonemizer/index";
  import { safeInit } from "../scripts/core/safe";

  safeInit("phonemizer", initPhonemizerLab);
</script>

<style>
  /* `.field` and `.field__label` are redeclared here on purpose: they live in
     the scoped style of the text station, so they are not global and copying the
     four declarations is what keeps this page looking like the same site. The
     values are that file's values, not a new scale. */
  .field {
    display: grid;
    gap: var(--space-2xs);
  }

  .field--inline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
  }

  .field__label {
    font-size: var(--step--2);
    font-weight: 600;
    color: var(--ink-faint);
  }

  .phon {
    display: grid;
    gap: var(--space-l);
  }

  .phon__input {
    display: grid;
    gap: var(--space-s);
    max-width: 62rem;
  }

  .phon__outputs {
    display: grid;
    gap: var(--space-m);
  }

  /* Side by side only when there is room for two readable columns; below that
     the comparison stacks, which keeps the IPA on one line per breath group. */
  @media (width >= 76rem) {
    .phon__outputs {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .panel {
    display: grid;
    gap: var(--space-s);
    align-content: start;
    min-width: 0;
    padding: var(--space-m);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }

  .panel__title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: 650;
  }

  .phon__ipa {
    margin: 0;
    min-height: 3.5rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .phon__notes {
    display: grid;
    gap: var(--space-2xs);
  }

  .phon__notes-title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-muted);
  }

  .phon__variants {
    margin: 0;
    padding-left: var(--space-m);
  }

  .phon__status {
    margin: 0;
    min-height: 1.4em;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .phon__status[data-state="error"] {
    color: var(--warn);
  }

  .phon__status[data-state="busy"] {
    color: var(--accent);
  }
</style>
