---
/**
 * Not found.
 *
 * GitHub Pages serves 404.html for any unknown path, so this page has to
 * stand alone: it uses the Spanish copy because that is the default locale,
 * and offers both language entry points.
 */
import Base from "../layouts/Base.astro";
---

<Base
  locale="es"
  path="/404"
  title="Página no encontrada"
  description="La página que buscas no existe en LinguaLab."
  noindex
>
  <section class="section">
    <div class="shell notfound">
      <p class="notfound__code mono" aria-hidden="true">404</p>
      <h1>Esta página no existe</h1>
      <p class="u-lead">
        Puede que el enlace esté mal escrito o que la página se haya movido. Estas son las
        herramientas disponibles:
      </p>

      <ul class="notfound__list" role="list">
        <li><a href="/tools">Estación textual</a> — análisis de corpus</li>
        <li><a href="/fono">FonoLab</a> — alfabeto fonético con corte sagital</li>
        <li><a href="/arboles">ArborLab</a> — árboles sintácticos y de datos</li>
        <li><a href="/glosario">Glosario</a> — términos de lingüística</li>
        <li><a href="/bibliografia">Bibliografía</a> — recursos con licencia</li>
        <li><a href="/seguridad">Seguridad</a> — verificación en vivo</li>
      </ul>

      <div class="cluster" style="margin-block-start: var(--space-l)">
        <a class="btn btn--primary" href="/">
          Volver al inicio <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn" href="/en/" hreflang="en" lang="en">English version</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .notfound {
    max-width: 44rem;
  }

  .notfound__code {
    margin: 0;
    font-size: clamp(3rem, 10vw, 6rem);
    line-height: 1;
    color: var(--line-strong);
  }

  .notfound__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    margin-block-start: var(--space-m);
    padding-inline-start: var(--space-s);
    color: var(--ink-muted);
  }

  .notfound__list a {
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  .notfound__list a:hover {
    text-decoration: underline;
  }
</style>
