---
/**
 * Not found.
 *
 * Vercel serves 404.html for any unknown path, so this page has to stand
 * alone: it has no address of its own (`standalone`), uses the Spanish copy
 * because that is the default locale, and offers both language entry points.
 *
 * The list used to be written by hand and had fallen six tools behind. It now
 * comes from the primary navigation, the same source as the masthead: the
 * catalogue is the one door that always lists every tool.
 */
import Base from "../layouts/Base.astro";
import { PRIMARY_NAV_ITEMS } from "../config/site";
import { localePath, t } from "../i18n";
import { baseRoot, withBase } from "../lib/paths";

const links = PRIMARY_NAV_ITEMS.map(({ path, labelKey }) => ({
  href: localePath("es", path),
  label: t("es", labelKey),
}));
---

<Base
  locale="es"
  path="/404"
  title="Página no encontrada"
  description="La página que buscas no existe en LinguaLab."
  noindex
  standalone
>
  <section class="section">
    <div class="shell notfound">
      <p class="notfound__code mono" aria-hidden="true">404</p>
      <h1>Esta página no existe</h1>
      <p class="u-lead">
        Puede que el enlace esté mal escrito o que la página se haya movido. Desde aquí puedes
        seguir:
      </p>

      <ul class="notfound__list" role="list">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>

      <div class="cluster u-mt-l">
        <a class="btn btn--primary" href={baseRoot()}>
          Volver al inicio <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn" href={withBase("/en/")} hreflang="en" lang="en">English version</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .notfound {
    max-width: 44rem;
  }

  .notfound__code {
    margin: 0;
    font-size: clamp(3rem, 10vw, 6rem);
    line-height: 1;
    /* Estaba en `--line-strong`, que es un token de LINEA: sirve para bordes y
       divisores, donde ser apenas visible es lo correcto, y como texto da un
       contraste de 2.02:1 donde WCAG 2.2 AA exige 3:1 para texto grande. El
       token de tinta es el que tiene la escala pensada para leerse. */
    color: var(--ink-faint);
  }

  .notfound__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    margin-block-start: var(--space-m);
    padding-inline-start: var(--space-s);
    color: var(--ink-muted);
  }

  .notfound__list a {
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  .notfound__list a:hover {
    text-decoration: underline;
  }
</style>
