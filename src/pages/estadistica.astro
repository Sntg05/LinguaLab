---
import TheoryNote from "../components/TheoryNote.astro";
import StatisticsLab from "../components/StatisticsLab.astro";
import Base from "../layouts/Base.astro";
import { t } from "../i18n";
---

<Base
  locale="es"
  path="/estadistica"
  title={t("es", "stats.meta.title")}
  description={t("es", "stats.meta.description")}
>
  <StatisticsLab locale="es" />
  <TheoryNote locale="es" tools={["statistics"]} />
</Base>
