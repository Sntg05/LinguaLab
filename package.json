{
  "name": "lingualab",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "description": "Plataforma de analisis linguistico que corre enteramente en el navegador: fonetica AFI, arboles sintacticos, analisis de corpus y bibliografia.",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:verify": "astro build && node scripts/verify-build.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "preview": "astro preview",
    "preview:e2e": "astro preview --port 4331 --ignore-lock",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "verify": "npm run check && npm run test && npm run build:verify",
    "lint": "biome lint .",
    "lint:baseline": "node scripts/lint-baseline.mjs",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck:packages": "npm run typecheck --workspaces --if-present",
    "typecheck": "npm run check && npm run typecheck:packages",
    "deps:check": "node scripts/deps-check.mjs",
    "data:languages": "node scripts/build-language-data.mjs",
    "audit": "npm audit --omit=dev --audit-level=high && (npm audit --audit-level=low || true)",
    "verify:all": "npm run lint && npm run format:check && npm run typecheck:packages && npm run deps:check && npm run verify",
    "commitlint": "commitlint --edit",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "{packages,e2e}/**/*.ts": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "{playwright.config.ts,tsconfig.base.json,biome.json,package.json}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@playwright/test": "1.64.1",
    "astro": "7.4.2",
    "dependency-cruiser": "18.7.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "pyodide": "314.0.7",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
